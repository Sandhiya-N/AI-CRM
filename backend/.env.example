# Application
DEBUG=false
APP_NAME=HCP CRM Backend

# Local development database
# Use SQLite by default so the backend can boot on any workstation without
# needing a local PostgreSQL password.
DATABASE_URL=sqlite+aiosqlite:///./hcp_crm.db

# Groq API — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it
GROQ_TEMPERATURE=0.2
